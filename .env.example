# Copy to backend/.env for local development. Never commit real secrets.

ENVIRONMENT=local
DEBUG=true
JWT_SECRET=change-me-local-only-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Docker Compose maps Postgres to host port 5433 (local PG often uses 5432).
DATABASE_URL=postgresql+asyncpg://poultry:poultry@localhost:5433/poultry_tracker
DATABASE_URL_SYNC=postgresql+psycopg2://poultry:poultry@localhost:5433/poultry_tracker
# Optional runtime role without BYPASSRLS (recommended for staging/prod):
# APP_DATABASE_URL=postgresql+asyncpg://app_user:app_user@localhost:5433/poultry_tracker

CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Cloudinary (optional — app works without media)
MEDIA_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
