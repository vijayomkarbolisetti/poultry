{
  "expo": {
    "name": "PoultryTrack",
    "slug": "poultry-vaccine-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "poultrytracker",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vijayomkar.poultrytracker",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#F0FDEF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PoultryTrack to attach photos from your library.",
          "cameraPermission": "Allow PoultryTrack to take photos for farm records."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4462ff8-81fe-496a-b6ad-76822e03f807"
      }
    },
    "owner": "vijayomkar.bolisetti"
  }
}
